{
  "name": "medicine-availability-platform",
  "version": "1.0.0",
  "description": "Local Medicine Availability Platform for Pharmacies",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "restart": "lsof -ti:5001 | xargs kill -9 2>/dev/null; node server.js",
    "kill-port": "lsof -ti:5001 | xargs kill -9 2>/dev/null || echo 'No process on port 5001'",
    "seed": "node seed-database.js",
    "build": "cd medinear-frontend && npm run build"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^7.0.0",
    "multer": "^2.0.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.4",
    "twilio": "^4.9.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.24",
    "nodemon": "^3.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18"
  }
}
